# Zugangsdaten fuer den Versand der Bewerbungen. Diese Datei ist nur ein
# Muster — die echten Werte gehoeren in die Umgebungsvariablen des Hosters
# (Hostinger: Website → Erweitert → Umgebungsvariablen) und NIE ins Repo.
#
# Ein eigenes Postfach beim Hoster reicht. Kein Formulardienst, keine
# Uebermittlung in ein Drittland.

BEWERBUNG_SMTP_HOST=smtp.hostinger.com
BEWERBUNG_SMTP_PORT=465
BEWERBUNG_SMTP_USER=postfach@deine-domain.de
BEWERBUNG_SMTP_PASS=
# Wohin die Bewerbungen gehen sollen.
BEWERBUNG_EMPFAENGER=
# Absender der Mail. Muss zum Postfach oben passen, sonst lehnt der
# Mailserver sie ab oder sie landet im Spam. Ohne Angabe wird der
# SMTP-Benutzer verwendet.
BEWERBUNG_ABSENDER=


# ---------------------------------------------------------------------------
# MITGLIEDERBEREICH
# ---------------------------------------------------------------------------

# Alles hier ist optional. Der Club laeuft ohne jede dieser Variablen:
# die Konten stehen in daten/mitglieder.json, den Schluessel fuer die
# Cookies legt der Server beim ersten Start selbst in daten/geheimnis an.

# Konten anlegen:  node tools/mitglied.mjs max@beispiel.de "Max Muster"
# Das schreibt den Eintrag in die Mitgliederdatei und schickt dem neuen
# Mitglied die Bestaetigung — ueber dieselben SMTP-Zugangsdaten wie das
# Bewerbungsformular oben.

# Die Adresse der Website, ohne Schraegstrich am Ende. Steht als Link
# "Zum Club" in der Bestaetigungsmail. Ohne Angabe fehlt der Link.
CLUB_ADRESSE=

# Wo die Mitgliederdatei liegt, wenn nicht in daten/. Sinnvoll, sobald der
# Hoster bei jedem Deploy das Projektverzeichnis frisch aus dem Repository
# aufsetzt — dann laege sie besser daneben als darin.
CLUB_MITGLIEDER_DATEI=

# Nebenweg fuer Hoster ohne Platz fuer eine Datei: dieselben Angaben in
# einer Zeile, Eintraege mit ; getrennt, Felder mit |. Gilt zusaetzlich
# zur Datei. Aendern heisst hier: Anwendung neu starten.
CLUB_MITGLIEDER=

# Unterschrift der Anmelde-Cookies, mindestens 32 Zeichen. Erzeugen mit:
#   node tools/mitglied.mjs --geheimnis
# Ohne Angabe nimmt der Server daten/geheimnis. Wird der Wert geaendert,
# sind alle laufenden Anmeldungen sofort ungueltig.
CLUB_SITZUNG_GEHEIMNIS=

# Wo die Videos der Masterclass liegen, ohne Schraegstrich am Ende.
# Daraus wird v01.mp4 … v40.mp4 zusammengesetzt. Vierzig Videos gehoeren
# nicht ins Repo — sie blieben fuer immer in der Historie.
CLUB_VIDEO_BASIS=

# Optional: JSON-Datei mit den News. Damit laesst sich etwas
# veroeffentlichen, ohne die Seite neu bereitzustellen.
CLUB_NEWS_DATEI=

# Optional: JSON-Datei mit den Events (Treffen in echt). Format siehe
# src/data/events.ts. Status ergibt sich aus Datum und "ausgebucht".
CLUB_EVENTS_DATEI=

# Optional: JSON-Datei mit den Live-Terminen. Damit laesst sich ein Termin
# ankuendigen oder verschieben, ohne die Seite neu bereitzustellen.
CLUB_LIVE_DATEI=
