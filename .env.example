# Zugangsdaten fuer den Versand der Bewerbungen. Diese Datei ist nur ein
# Muster — die echten Werte gehoeren in die Umgebungsvariablen des Hosters
# (Hostinger: Website → Erweitert → Umgebungsvariablen) und NIE ins Repo.
#
# Ein eigenes Postfach beim Hoster reicht. Kein Formulardienst, keine
# Uebermittlung in ein Drittland.

BEWERBUNG_SMTP_HOST=smtp.hostinger.com
BEWERBUNG_SMTP_PORT=465
BEWERBUNG_SMTP_USER=postfach@deine-domain.de
BEWERBUNG_SMTP_PASS=
# Wohin die Bewerbungen gehen sollen.
BEWERBUNG_EMPFAENGER=
# Absender der Mail. Muss zum Postfach oben passen, sonst lehnt der
# Mailserver sie ab oder sie landet im Spam. Ohne Angabe wird der
# SMTP-Benutzer verwendet.
BEWERBUNG_ABSENDER=


# ---------------------------------------------------------------------------
# MITGLIEDERBEREICH
# ---------------------------------------------------------------------------

# Unterschrift der Anmelde-Cookies. Mindestens 32 Zeichen, sonst kommt
# niemand herein. Erzeugen mit:  node tools/mitglied.mjs --geheimnis
# Wird der Wert geaendert, sind alle laufenden Anmeldungen sofort ungueltig.
CLUB_SITZUNG_GEHEIMNIS=

# Wer hinein darf. Zwei Wege, einer reicht:
#
# a) Pfad zu einer JSON-Datei auf dem Server. Der bessere Weg — ein neues
#    Mitglied eintragen, speichern, fertig, ohne neuen Deploy.
CLUB_MITGLIEDER_DATEI=
#
# b) Oder dieselben Angaben in einer Zeile, falls der Hoster keinen Platz
#    fuer eine Datei bietet. Eintraege mit ; trennen, Felder mit |
#    Aendern heisst hier: Anwendung neu starten.
CLUB_MITGLIEDER=
#
# Beide Formate erzeugt:  node tools/mitglied.mjs <e-mail> "<name>"
# Klartext-Passwoerter stehen an keiner der beiden Stellen.

# Wo die Videos der Masterclass liegen, ohne Schraegstrich am Ende.
# Daraus wird v01.mp4 … v40.mp4 zusammengesetzt. Vierzig Videos gehoeren
# nicht ins Repo — sie blieben fuer immer in der Historie.
CLUB_VIDEO_BASIS=

# Optional: JSON-Datei mit den Nachrichten des Kanals. Damit laesst sich
# etwas veroeffentlichen, ohne die Seite neu bereitzustellen.
CLUB_KANAL_DATEI=
