# Gilt nur, wenn die Seite als statischer Export (STATIC_EXPORT=1) auf einem
# Apache-Webhosting liegt. Laeuft sie als Node-Anwendung (npm start, so wie
# aktuell auf Hostinger), setzt next.config.ts dieselben Regeln und diese
# Datei wird nie gelesen.

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By

  # HTML nie zwischenspeichern, sonst sieht man nach einem Deploy die alte Seite.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Alles mit Hash im Namen oder fester Nummer: ein Jahr.
  <FilesMatch "\.(css|js|mjs|woff2?|jpe?g|png|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# HTTPS erzwingen. Die Weiterleitung auf eine feste Domain (www / ohne www)
# fehlt bewusst — dafuer muss die Domain feststehen.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
